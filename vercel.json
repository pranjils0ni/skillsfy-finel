{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/articles/:slug*",
      "destination": "https://articles.skillsfy.in/:slug*",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "https://articles.skillsfy.in",
      "permanent": true
    },
    {
      "source": "/guides/:slug*",
      "destination": "https://articles.skillsfy.in/:slug*",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "https://articles.skillsfy.in",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "has": [
        {
          "type": "host",
          "value": "articles.skillsfy.in"
        }
      ],
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "articles.skillsfy.in"
        }
      ],
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "articles.skillsfy.in"
        }
      ],
      "source": "/:slug*",
      "destination": "/api/articles?slug=:slug*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "articles.skillsfy.in"
        }
      ],
      "source": "/",
      "destination": "/api/articles"
    },
    { "source": "/api/articles", "destination": "/api/articles" },
    { "source": "/article/:slug*", "destination": "/api/article" },
    { "source": "/article", "destination": "/api/article" },
    { "source": "/insights", "destination": "/insights.html" },
    { "source": "/login", "destination": "/login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
